{
  "name": "@beyondthecloud/sf-veles",
  "version": "0.2.0",
  "description": "SF CLI plugin for Veles — set up Veles on existing scratch orgs and sandboxes and connect them to your Veles Hub",
  "type": "module",
  "main": "lib/commands/veles/setup.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beyond-the-cloud-dev/sf-veles.git"
  },
  "homepage": "https://github.com/beyond-the-cloud-dev/sf-veles",
  "bugs": {
    "url": "https://github.com/beyond-the-cloud-dev/sf-veles/issues"
  },
  "keywords": [
    "salesforce",
    "sf-cli",
    "sf",
    "oclif-plugin",
    "veles",
    "scratch-org",
    "sandbox",
    "provisioning"
  ],
  "files": [
    "lib",
    "messages",
    "oclif.manifest.json"
  ],
  "dependencies": {
    "@oclif/core": "^4",
    "@salesforce/core": "^8",
    "@salesforce/sf-plugins-core": "^12"
  },
  "devDependencies": {
    "oclif": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "demo:output": "node scripts/setup-output-demo.mjs",
    "prepack": "npm run clean && npm run build && oclif manifest",
    "test": "npm run build && node --test test/*.test.js"
  },
  "oclif": {
    "commands": "./lib/commands",
    "bin": "sf",
    "topicSeparator": " ",
    "topics": {
      "veles": {
        "description": "Commands for setting up Veles on scratch orgs and sandboxes"
      }
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
